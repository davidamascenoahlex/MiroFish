# MiroFish self-hosted configuration example. Store real credentials in a
# Kubernetes Secret; do not commit a populated .env file.

SECRET_KEY=replace_with_a_random_secret

# OpenAI-compatible chat completion API
LLM_API_KEY=your_chat_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Embeddings use an independent key and endpoint; no chat-key fallback exists.
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIM=1536

# For MiroFish and Neo4j containers in the same Kubernetes Pod, use direct
# bolt:// on loopback. Unencrypted neo4j:// routing can reach remote hosts.
# Remote endpoints require certificate-verified bolt+s:// or neo4j+s://.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_strong_password
GRAPHITI_STRUCTURED_OUTPUT_MODE=json_object
FLASK_DEBUG=False

# Graph ingestion chunking for new projects. Larger chunks need fewer LLM calls.
GRAPH_CHUNK_SIZE=1000
GRAPH_CHUNK_OVERLAP=100

# Optional LLM acceleration. Omit these variables when unused.
# LLM_BOOST_API_KEY=your_api_key
# LLM_BOOST_BASE_URL=https://your-accelerated-endpoint/v1
# LLM_BOOST_MODEL_NAME=your-model
